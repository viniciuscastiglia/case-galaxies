# Copie para .env e preencha. Nunca faça commit do .env.
YOUTUBE_API_KEY=
# Rubrica do VLM (Gemini, free tier do AI Studio): só Shorts já publicados (princípio 5).
GOOGLE_API_KEY=
# Onde ficam os dados (a base, as capas, os frames) e os artefatos do modelo. Opcionais: vazio ou
# ausente vale o padrão (data/ e artefatos/ na raiz do repo). Têm de ser caminhos absolutos; um
# valor relativo falha na importação do previa. Os testes ignoram os dois (usam uma pasta temporária).
# PREVIA_DADOS=/caminho/absoluto/para/data
# GALAXIES_ARTEFATOS=/caminho/absoluto/para/artefatos
